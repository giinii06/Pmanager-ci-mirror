# Absolute path to the folder that holds your originals.
# macOS development: ./sample-media
# WSL2 production:  /mnt/d/Media
MEDIA_ROOT=./sample-media

# Host port for the nginx entry point.
MEDIAVAULT_PORT=8080

# Optional. When empty a secret is generated in data/secret.key.
AUTH_SECRET=

# Optional. Set to nvenc on a machine with the NVIDIA Container Toolkit.
HWACCEL=
