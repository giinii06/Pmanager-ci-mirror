# Host folder that holds the originals. The production compose bind requires
# this value and never creates the folder. Use compose.dev.yaml for samples.
# WSL2 production: /mnt/d
MEDIA_ROOT=/mnt/d

# Extra drives. The base compose mounts only MEDIA_ROOT. Include
# compose.drives.yaml to mount these four paths at /media/extra and
# /media/drives/{c,d,e}. Register a library under "extra/<folder>" or
# "drives/<letter>/<folder>". Every path must exist before the stack starts.
EXTRA_MEDIA_ROOT=/mnt/e
DRIVE_C_ROOT=/mnt/c
DRIVE_D_ROOT=/mnt/d
DRIVE_E_ROOT=/mnt/e

# Host port for the nginx entry point. It binds to 127.0.0.1 only.
MEDIAVAULT_PORT=8080

# Optional. When empty a secret is generated in the data volume (secret.key).
AUTH_SECRET=

# Set to 1 when the app is served over HTTPS (TLS-terminating reverse proxy).
COOKIE_SECURE=0

# Optional. Use with compose.gpu.yaml on a machine with the NVIDIA Container
# Toolkit; the worker falls back to libx264 when NVENC is unavailable.
HWACCEL=

# The card every GPU consumer leases. The media worker takes it before an NVENC
# encode, and the ASR, translation and embedding workers take it before they
# start a model server, so two of them never hold the card at once.
GPU_RESOURCE=gpu:0

# How often a library is re-scanned for new or changed files, in minutes. The
# API checks every five minutes and queues a scan once this interval has passed.
SCAN_INTERVAL_MINUTES=15

# A scan that would hide more than this share of a library is refused, and a
# run that would hide every asset is refused regardless of the share. Set the
# force flag only when a large deletion is intended on a healthy root.
SCAN_DELETE_GUARD_RATIO=0.2
SCAN_DELETE_FORCE=0
# Optional absolute cap: a scan that would hide more than this many assets is
# refused even when the share is small. 0 disables the cap.
SCAN_DELETE_MAX_ABSOLUTE=0

# Deletes go through a quarantine state machine run by the worker. While this is
# off, every delete request returns 503 and no original file is touched.
FILE_MUTATION_ENGINE_ENABLED=0

# Test seam for a full cursor walk. Leave unset unless measuring.
# PIPELINE_BATCH=500

# ASR is optional. See .env.asr.example; the compose.asr.*.yaml overrides read
# ASR_WORKER_TOKEN, ASR_MODEL_REVISION and ALIGN_MODEL_REVISION.
ASR_WORKER_TOKEN=
