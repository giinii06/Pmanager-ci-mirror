# Copy to .env.embedding before starting the embedding stack. The CUDA and
# mac-api overlays load this file with env_file, so each value below reaches the
# API, the downloader and the worker exactly as written. The models overlay
# alone only feeds the downloader and does not configure the API.

# Shared secret between the Fastify API and the Python worker. 32+ random bytes.
#   openssl rand -hex 32
EMBEDDING_WORKER_TOKEN=

# Model identity. The downloader refuses to run without a pinned commit and a
# SHA256, and the API puts both in the job key, so a model change rebuilds old
# vectors instead of silently mixing two spaces.
EMBEDDING_MODEL_ID=Qwen/Qwen3-Embedding-4B-GGUF
# The 40-character commit SHA that uploaded the file below. "main" is rejected:
# a tag or branch can move under the same name.
EMBEDDING_MODEL_REVISION=f4602530db1d980e16da9d7d3a70294cf5c190be
EMBEDDING_MODEL_SHA256=2b0cf8f17b4c723c27303015383c27ec4bf2d8314bb677d05e920dd70bb0f16b

# --- embedding-model-init ---

EMBEDDING_MODEL_FILENAME=Qwen3-Embedding-4B-Q4_K_M.gguf
# Container path of the model root. Compose sets /models; this value only
# matters when the downloader runs on the host.
MODELS_DIR=/models
# Optional, recorded in model-manifest.json. Derived from the filename when empty.
# EMBEDDING_MODEL_QUANTIZATION=Q4_K_M
# Optional. Only needed for a gated repository or a private mirror.
HF_TOKEN=
# Accept a branch or tag instead of a commit. The manifest then records a
# revision that can move, so leave this at 0.
ALLOW_FLOATING_REVISION=0

# --- API ---

# 1 enables embeddings. 0 leaves the worker routes unregistered (404) and keeps
# /api/assets/:id/related on the folder heuristic. Leave it empty until the token
# below is set: the API refuses to start with EMBEDDING_ENABLED=1 and no token.
EMBEDDING_ENABLED=
# Bump when the chunking or the document layout changes, so old vectors are
# rebuilt instead of compared against new ones.
EMBEDDING_PIPELINE_VERSION=1
# Qwen3-Embedding-4B writes 2560 values per text. A different value here would
# reject every vector the worker sends.
EMBEDDING_DIMENSIONS=2560

# --- embedding-worker ---

# Compose sets this to http://api:8787. A worker running on the host uses
# http://127.0.0.1:8788 and passes it on the command line instead.
# API_BASE_URL=
# Container path of the GGUF file. A host run uses
# ../../models/embedding/Qwen3-Embedding-4B-Q4_K_M.gguf.
EMBEDDING_MODEL_PATH=/models/embedding/Qwen3-Embedding-4B-Q4_K_M.gguf
# The CUDA image provides llama-server. On macOS point this at the Homebrew
# binary, or pass it on the command line.
LLAMA_SERVER=llama-server
# Loopback port for the llama-server the worker starts per job.
LLAMA_PORT=8090
# Offload every layer first. Lower both values if the card runs out of memory.
# 8192 tokens covers a title plus 8 passages of 1200 characters.
LLAMA_GPU_LAYERS=99
LLAMA_CTX=8192
# Seconds to wait for llama-server to answer, and to wait for the shared GPU
# lease before the job is failed. The kind that just released the card
# waits one turn, so this has to outlast one ASR stage.
LLAMA_START_TIMEOUT=180
GPU_WAIT_SECONDS=1800
# Tuning knobs that are fine at their defaults: texts per request, job lease,
# idle poll interval, and the timeout on one API call.
# EMBEDDING_BATCH_SIZE=8
# LEASE_MS=120000
# POLL_SECONDS=3
# REQUEST_TIMEOUT=300
