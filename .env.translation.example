# Copy to .env.translation before starting the translation stack.
# compose.translation.*.yaml loads this file with env_file, so each value below
# reaches the API, the downloader and the worker exactly as written.

# Shared secret between the Fastify API and the Python worker. 32+ random bytes.
#   openssl rand -hex 32
TRANSLATION_WORKER_TOKEN=

# Model identity. The downloader refuses to run without a pinned commit and a
# SHA256, and the API puts both in the job key, so a model change rebuilds old
# translations instead of silently reusing them.
TRANSLATION_MODEL_ID=IndexTeam/Index-Translate-9B-GGUF
# Paste the 40-character commit SHA from the repository's commit history.
# "main" is rejected: a tag or branch can move under the same name.
TRANSLATION_MODEL_REVISION=
TRANSLATION_MODEL_SHA256=9cc6758b0007f4cbf42ea3400768cbff91ae74ef8d640e467158348426d33713

# --- translation-model-init ---

TRANSLATION_MODEL_FILENAME=Index-Translate-9B.Q4_K_M.gguf
# Container path of the model root. Compose sets /models; this value only
# matters when the downloader runs on the host.
MODELS_DIR=/models
# Optional, recorded in model-manifest.json. Derived from the filename when empty.
# TRANSLATION_MODEL_QUANTIZATION=Q4_K_M
# Optional. Only needed for a gated repository or a private mirror.
HF_TOKEN=
# Accept a branch or tag instead of a commit. The manifest then records a
# revision that can move, so leave this at 0.
ALLOW_FLOATING_REVISION=0

# --- API ---

# 1 enables translation, 0 makes the translation routes answer 503 and leaves
# the gallery untouched. Empty means "enabled once the token is set".
TRANSLATION_ENABLED=1
# Where translation results go. compose.translation.*.yaml overrides this with
# /asr-results so the API and the workers share one tree.
TRANSLATION_RESULT_DIR=./asr-results
# Bump when the prompt or the cue-splitting logic changes.
TRANSLATION_PROMPT_VERSION=1
TRANSLATION_PIPELINE_VERSION=1
# Language written for a non-Korean source. A Korean source gets no job at all.
TRANSLATION_TARGET_DEFAULT=ko

# --- shared GPU ---

# One lease per physical card, shared with the ASR, embedding and media workers.
# The API reads this too; the media worker uses it to take the card for NVENC.
GPU_RESOURCE=gpu:0

# --- translation-worker ---

# Compose sets this to http://api:8787. A worker running on the host uses
# http://127.0.0.1:8788 and passes it on the command line instead.
# API_BASE_URL=
# Container path of the GGUF file. A host run uses
# ../../models/translation/Index-Translate-9B.Q4_K_M.gguf.
TRANSLATION_MODEL_PATH=/models/translation/Index-Translate-9B.Q4_K_M.gguf
# Same tree as the API.
RESULT_DIR=/asr-results
# The CUDA image provides llama-server. On macOS point this at the Homebrew
# binary, or pass it on the command line.
LLAMA_SERVER=llama-server
# Loopback port for the llama-server the worker starts per job.
LLAMA_PORT=8089
# Offload every layer first. Lower both values if the card runs out of memory.
LLAMA_GPU_LAYERS=99
LLAMA_CTX=4096
# Seconds to wait for llama-server to answer, and to wait for the shared GPU
# lease before the job is failed.
LLAMA_START_TIMEOUT=180
GPU_WAIT_SECONDS=600
# Tuning knobs that are fine at their defaults: cues per request, job lease,
# idle poll interval, and the timeout on one API call.
# TRANSLATION_BATCH_SEGMENTS=8
# LEASE_MS=120000
# POLL_SECONDS=3
# REQUEST_TIMEOUT=300
