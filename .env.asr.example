# Copy to .env (or merge into the existing one) before starting the ASR stack.
# Every value here is read by compose.asr.*.yaml.

# Shared secret between the Fastify API and the Python worker. 32+ random bytes.
#   openssl rand -hex 32
ASR_WORKER_TOKEN=

# Pinned model revisions. Use the commit SHA, not "main", so a re-run is
# reproducible and the result cache key stays stable.
ASR_MODEL_ID=TeamUNIVA/qwen3_asr_1.7b_ko
ALIGN_MODEL_ID=Qwen/Qwen3-ForcedAligner-0.6B
ASR_MODEL_REVISION=a8b7485274ac50e80a685f3813489fed475adc5f
ALIGN_MODEL_REVISION=c7cbfc2048c462b0d63a45797104fc9db3ad62b7

# Optional hint. Leave it empty to let the model detect the spoken language of
# every file; set e.g. "ko" only when detection misfires. The transcript always
# records the language that was actually heard.
ASR_LANGUAGE=

# Bump when the chunking, subtitle or language logic changes so old results are
# rebuilt.
ASR_PIPELINE_VERSION=2

# Where the API and the worker keep transcript.json / subtitles.vtt / .srt.
# Must be on an SSD, never on the media drive.
ASR_RESULT_DIR=./asr-results

# cuda | mps | cpu | auto. The native macOS worker uses mps.
ASR_DEVICE=auto

# Optional. Only needed for a gated Hugging Face repository.
HF_TOKEN=
