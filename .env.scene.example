# Copy to .env.scene (or merge into the existing .env) before starting the
# scene stack. Every value here is read by compose.scene.*.yaml.

# Shared secret between the Fastify API and the scene worker. 32+ random bytes.
#   openssl rand -hex 32
SCENE_WORKER_TOKEN=

# Pinned model revision. Use the commit SHA, not "main", so a re-run is
# reproducible and the result cache key stays stable.
SCENE_MODEL_ID=facebook/pe-av-base-16-frame
SCENE_MODEL_REVISION=3fd870e60a1099fb99367b240d41926e183d7112

# Bump when the window plan or the vector layout changes so old rows are rebuilt.
SCENE_PIPELINE_VERSION=1

# Window length and overlap. The API owns these values and sends them with each
# job, so the worker and the query encoder cannot disagree with it.
SCENE_WINDOW_SECONDS=10
SCENE_OVERLAP_SECONDS=2

# How long a scene job waits for the shared card. The worker that just released
# the card steps back for one turn, so this has to outlast one ASR stage.
SCENE_GPU_WAIT_SECONDS=3600

# Reuse the cut clip for the window thumbnail instead of seeking into the
# original file a second time. Off by default: the clip is padded to a square,
# so a portrait thumbnail may show black bars. Turn it on after checking a
# landscape and a portrait sample.
SCENE_THUMBNAIL_FROM_CLIP=0

# Optional. Only needed for a gated Hugging Face repository.
HF_TOKEN=
