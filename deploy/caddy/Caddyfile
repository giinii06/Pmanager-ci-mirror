# Set MEDIAVAULT_TLS_HOST to the DNS name or LAN IP used in the browser.
# Real public domains need reachable TCP 443 for ACME TLS-ALPN validation.
# Localhost/LAN IPs use Caddy's internal CA and require explicit trust on each client.
{
    auto_https disable_redirects
}

https://{$MEDIAVAULT_TLS_HOST:localhost} {
    encode zstd gzip
    reverse_proxy nginx:8080
}
