# Copy to .env.face (or merge into the existing .env) before starting the face
# stack. Every value here is read by compose.face*.yaml.

# Shared secret between the Fastify API and the face worker. 32+ random bytes.
#   openssl rand -hex 32
FACE_WORKER_TOKEN=

# The insightface pack and the GitHub release tag it comes from. The pack is
# unpacked into ./models/face/models/<pack>.
FACE_MODEL_ID=antelopev2
FACE_MODEL_REVISION=v0.7

# Bump when sampling or the vector layout changes so old rows are rebuilt.
FACE_PIPELINE_VERSION=1

# One frame every two seconds. Longer videos double the interval until the
# frame count fits under 900.
FACE_SAMPLE_MS=2000

# Detection score floor before a face is embedded.
FACE_MIN_SCORE=0.5

# Cosine floors for people assignment. Approved people win a tie, and anything
# between the two floors becomes a candidate group for review.
FACE_MATCH_THRESHOLD=0.45
FACE_CANDIDATE_THRESHOLD=0.5
